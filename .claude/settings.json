{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && .venv/Scripts/python scripts/resume_check.py 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Checking where work left off..."
          }
        ]
      }
    ]
  }
}
