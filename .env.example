# --- core ---
APP_ENV=dev                      # dev | test | prod
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# direct Neon URL; used for migrations and LangGraph setup; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=
SESSION_SECRET=change-me-generate-with-python-secrets-token-urlsafe-48
# --- auth ---
SIGNUPS_ENABLED=true
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
SESSION_MAX_AGE_DAYS=30
# lifetime of sessions without "remember me"; must be below SESSION_MAX_AGE_DAYS * 24
SESSION_SHORT_MAX_AGE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# --- cost protection ---
RUNS_PER_HOUR=10
DAILY_LLM_CALL_CAP=500
MAX_UPLOAD_MB=10
MAX_FILES_PER_REPORT=5
# --- upload & ingestion limits ---
# size of one upload chunk in MB (max 4.4: Vercel rejects request bodies above 4.5 MB)
UPLOAD_CHUNK_MB=4.0
# .xlsx zip-bomb guards: max compression ratio and max total uncompressed size (MB)
MAX_UNCOMPRESSED_RATIO=100
MAX_UNCOMPRESSED_MB=200
# non-empty rows kept per table / source rows scanned (empty ones included) / widest accepted row
MAX_ROWS_PER_FILE=200000
MAX_SCAN_ROWS_PER_FILE=1000000
MAX_COLUMNS_PER_FILE=500
# data rows shown by the file preview (max 500)
PREVIEW_ROWS=50
# --- file storage ---
# local | vercel ("vercel" = private Vercel Blob store; the SDK reads BLOB_STORE_ID + Vercel OIDC);
# must be "vercel" when APP_ENV=prod
BLOB_BACKEND=local
# root directory of the local blob store (dev/tests only)
LOCAL_BLOB_DIR=.local_blobs
# --- ingestion: schema detection ---
# non-empty values sampled per column to guess its role (min 10)
DETECT_SAMPLE_ROWS=200
# leading non-empty rows scanned for the header row (title rows above it are skipped)
DETECT_HEADER_SCAN_ROWS=20
# column-role confidence (0-1) below which the user must confirm the suggested mapping
MAPPING_MIN_CONFIDENCE=0.8
# --- public statistics APIs (Eurostat, World Bank) ---
# base URLs (must be https://)
EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data
WORLDBANK_BASE_URL=https://api.worldbank.org/v2
# per-attempt timeout; retries after 429/5xx/timeouts/non-JSON bodies; first retry delay (doubles each retry)
API_TIMEOUT_S=20
API_RETRIES=3
API_BACKOFF_S=1.0
# API responses larger than this are refused (memory guard)
API_MAX_RESPONSE_MB=20
# wall-clock budget per fetch (all retries, waits incl. Retry-After, and pages)
API_TOTAL_BUDGET_S=60
# World Bank rows per page, and the page limit beyond which a request is refused
WORLDBANK_PER_PAGE=1000
WORLDBANK_MAX_PAGES=20
# --- combining sources (D-010) ---
# values from different sources conflict when they differ by more than max(this x |value|, rounding unit)
CONFLICT_REL_TOL=0.005
# --- RAG knowledge base (M5) ---
# D-011: vector search when true AND an embeddings key exists; otherwise Postgres full-text search
ENABLE_VECTOR_SEARCH=true
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# must equal the kb_chunks.embedding column size (migration 004); max 2000 (pgvector HNSW)
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
# passages per retrieval; chunk size/overlap in characters (overlap must be below size)
RAG_TOP_K=6
# upper bound for any requested number of passages (RAG_TOP_K must not exceed it)
RAG_MAX_K=50
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
# user-uploaded reference documents (.pdf/.txt/.md): size cap (MB) and PDF page cap
MAX_REFERENCE_MB=10
MAX_REFERENCE_PAGES=300
# --- analysis & verification (D-010) ---
# |change| that flags a rate (percentage points) / a level (percent)
SIGNIFICANCE_RATE_PP=1.0
SIGNIFICANCE_LEVEL_PCT=2.0
# top movers by |YoY| per indicator and period when >= 2 regions (0 disables)
TOP_MOVERS=3
# verify -> revise cycles before the "needs manual attention" safe failure; retries of an unparseable draft
MAX_REVISIONS=3
MAX_PARSE_RETRIES=2
# node-level retries of a model call that failed (provider error, timeout); the daily cap never retries
MAX_MODEL_RETRIES=1
# --- LLM layer (M6) ---
# chat model = init_chat_model("<LLM_PROVIDER>:<LLM_MODEL>"); the key is OPENAI_API_KEY (above)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
# ignored by reasoning models (gpt-5 / gpt-5-mini accept only the default temperature)
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# structured output: function_calling (tool call) | json_schema (OpenAI strict mode; likely rejected:
# ReportDraft uses minLength, which strict schemas do not accept)
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
# model turns per tool-calling loop; rows one query_observations call may return
LLM_MAX_TOOL_STEPS=6
MAX_TOOL_ROWS=200
# rows all query_observations calls of one tool loop may return together (AC 35: selected rows only)
MAX_TOOL_ROWS_PER_TURN=400
# metrics / retrieved passages included in one prompt
PROMPT_MAX_METRICS=80
PROMPT_MAX_PASSAGES=8
# skipped-metric lines (reasons for gaps) in one prompt
PROMPT_MAX_SKIPS=40
# debug only: store prompt and response text in run_events (visible to the report owner)
LOG_PROMPTS=false
# --- LangGraph workflow (M7) ---
# Send fan-out per source and per region x indicator (false: one sequential node, same results)
ENABLE_PARALLEL=true
# history / replay / fork from checkpoints
ENABLE_REPLAY=true
# let the model call the controlled tools while drafting (ignored for models without tool calling)
ENABLE_DRAFT_TOOLS=true
# seconds one run segment may take (must stay below Vercel's 300 s maxDuration); then the browser reconnects
SEGMENT_BUDGET_S=240
# LangGraph super-steps per invocation
GRAPH_RECURSION_LIMIT=60
# --- infra ---
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_SETUP_LOCK_TIMEOUT_S=60
# libpq connect timeout per connection attempt (rounded up to whole seconds; libpq minimum is 2)
DB_CONNECT_TIMEOUT_S=5.0
# max seconds a cold start waits for the pool to open before giving up (PoolTimeout -> 503)
DB_POOL_OPEN_TIMEOUT_S=10.0
# max seconds /healthz waits for a pooled connection before reporting 503
HEALTHZ_DB_TIMEOUT_S=3.0
CRON_SECRET=change-me
# --- diagnostics (risk spike R2: /_diag/sse) ---
SSE_DIAG_TICKS=5
SSE_DIAG_INTERVAL_S=1.0
# expose /_diag/* when APP_ENV=prod (always on in dev/test); ticks*interval must be < 290 s
ENABLE_DIAG_ENDPOINTS=false
# --- exports (M9; presentation only, values are never rounded in storage) ---
EXPORT_DEFAULT_DECIMALS=2
EXPORT_CHART_MAX_SERIES=6
# --- retention (M9, D-009 / AC 50; daily /cron/cleanup needs CRON_SECRET) ---
RETENTION_UNFINISHED_DAYS=30
RETENTION_APPROVED_DAYS=7
CHECKPOINT_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
UPLOAD_ABANDON_HOURS=24
# blobs no files/report_versions row references are deleted once older than this (orphan sweep)
BLOB_ORPHAN_GRACE_HOURS=24
RETENTION_BATCH_SIZE=500
